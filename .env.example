# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000

# ── AI Provider ──────────────────────────────────────────────────────────────
# Which AI provider to use. Supported: "gemini", "openrouter".
# To add OpenAI directly later: set to "openai" and run: npm install @langchain/openai
MODEL_PROVIDER=openrouter

# ── Google Gemini ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ── OpenRouter (used when MODEL_PROVIDER=openrouter) ─────────────────────────
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any model string from https://openrouter.ai/models
# e.g. "anthropic/claude-sonnet-4-5", "google/gemini-2.5-flash", "openai/gpt-4o-mini"
OPENROUTER_MODEL=

# ── OpenAI (optional — used when MODEL_PROVIDER=openai) ──────────────────────
# OPENAI_API_KEY=your_openai_api_key_here

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=your_postgres_connection_string_here

# ── Tunnel (required before npm run dev — Instagram needs a public HTTPS URL) ─
# Get your authtoken at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# ── Social / Publishing ───────────────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
PUBLIC_BASE_URL=
